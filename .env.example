NODE_ENV=development
PORT=3000

MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/masterplan
# MONGO_URI can be used instead of MONGODB_URI if preferred.
# MONGO_URI=mongodb://127.0.0.1:27017/masterplan

SESSION_SECRET=replace-with-a-long-random-secret

ADMIN_FULL_NAME=System Owner
ADMIN_EMAIL=admin@example.com
ADMIN_MOBILE_NUMBER=+260000000000
ADMIN_PASSWORD=replace-with-a-strong-admin-password

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
# AI_API_KEY can be used instead of OPENAI_API_KEY if preferred.
# AI_API_KEY=sk-your-openai-api-key

AI_TIMEOUT_MS=45000
ENHANCEMENT_TIMEOUT_MS=600000
AI_MAX_OUTPUT_TOKENS=16384
ENHANCED_SECTION_MAX_OUTPUT_TOKENS=5500

ENHANCEMENT_FEE_AMOUNT=75
ENHANCEMENT_FEE_CURRENCY=ZMW
MOBILE_MONEY_MERCHANT_NUMBER=+260000000000
