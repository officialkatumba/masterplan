<%- include('../partials/header') %>
<main class="container py-5">
  <div class="auth-card">
    <div class="text-center mb-4">
      <h1 class="h2">Forgot Password</h1>
      <p class="text-muted">We'll send you a link to reset it.</p>
    </div>
    
    <% if (error) { %>
      <div class="alert alert-danger border-0 rounded-3 mb-4" style="background: rgba(255, 61, 104, 0.12); color: #9f1239;" role="alert">
        <%= error %>
      </div>
    <% } %>
    
    <% if (message) { %>
      <div class="alert alert-success border-0 rounded-3 mb-4" role="alert">
        <%= message %>
        <% if (resetUrl) { %>
          <hr>
          <p class="mb-0"><strong>Development Mode:</strong> <a href="<%= resetUrl %>">Click here to reset your password</a></p>
        <% } %>
      </div>
    <% } else { %>
      <form action="/forgot-password" method="post" class="stack-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        
        <div class="mb-4">
          <label for="identifier" class="form-label">Email or Phone Number</label>
          <input type="text" id="identifier" name="identifier" class="form-control" required autofocus>
        </div>
        
        <button type="submit" class="btn btn-primary w-100 py-3 text-uppercase fw-bold" style="letter-spacing: 0.05em;">Send Reset Link</button>
        
        <div class="text-center mt-4 pt-3 border-top">
          <a href="/login" class="fw-bold">Back to Sign in</a>
        </div>
      </form>
    <% } %>
  </div>
</main>
<%- include('../partials/footer') %>
