<%- include('../partials/header') %>
<main class="container py-5">
  <div class="auth-card">
    <div class="text-center mb-4">
      <h1 class="h2">Reset Password</h1>
      <p class="text-muted">Enter your new password below.</p>
    </div>
    
    <% if (error) { %>
      <div class="alert alert-danger border-0 rounded-3 mb-4" style="background: rgba(255, 61, 104, 0.12); color: #9f1239;" role="alert">
        <%= error %>
      </div>
    <% } %>

    <form action="/reset-password/<%= token %>" method="post" class="stack-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      
      <div class="mb-4">
        <label for="password" class="form-label">New Password</label>
        <input type="password" id="password" name="password" class="form-control" placeholder="At least 8 characters" minlength="8" required autofocus>
      </div>
      
      <button type="submit" class="btn btn-primary w-100 py-3 text-uppercase fw-bold" style="letter-spacing: 0.05em;">Reset Password</button>
    </form>
  </div>
</main>
<%- include('../partials/footer') %>
