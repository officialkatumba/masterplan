<%- include('../partials/header') %>
<main class="container py-5">
  <div class="auth-card">
    <div class="text-center mb-4">
      <h1 class="h2">Change Password</h1>
      <p class="text-muted">Update your account security.</p>
    </div>
    
    <% if (error) { %>
      <div class="alert alert-danger border-0 rounded-3 mb-4" style="background: rgba(255, 61, 104, 0.12); color: #9f1239;" role="alert">
        <%= error %>
      </div>
    <% } %>
    
    <% if (message) { %>
      <div class="alert alert-success border-0 rounded-3 mb-4" role="alert">
        <%= message %>
      </div>
      <div class="text-center">
        <a href="/dashboard" class="btn btn-primary w-100 py-3 text-uppercase fw-bold" style="letter-spacing: 0.05em;">Back to Dashboard</a>
      </div>
    <% } else { %>
      <form action="/account/password" method="post" class="stack-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        
        <div class="mb-3">
          <label for="currentPassword" class="form-label">Current Password</label>
          <input type="password" id="currentPassword" name="currentPassword" class="form-control" required autofocus>
        </div>
        
        <div class="mb-4">
          <label for="newPassword" class="form-label">New Password</label>
          <input type="password" id="newPassword" name="newPassword" class="form-control" placeholder="At least 8 characters" minlength="8" required>
        </div>
        
        <button type="submit" class="btn btn-primary w-100 py-3 text-uppercase fw-bold" style="letter-spacing: 0.05em;">Update Password</button>
        
        <div class="text-center mt-4 pt-3 border-top">
          <a href="/dashboard" class="text-muted fw-bold">Cancel and return</a>
        </div>
      </form>
    <% } %>
  </div>
</main>
<%- include('../partials/footer') %>
