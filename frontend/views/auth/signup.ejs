<%- include('../partials/header') %>
<main class="container page-shell">
  <div class="auth-card">
    <div class="text-center mb-4">
      <span class="section-kicker">Register</span>
      <h1>Create your account</h1>
      <p class="text-muted">All fields are required to start your free business plan.</p>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger border-0 rounded-4"><%= error %></div>
    <% } %>

    <form action="/register" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="mb-3">
        <label class="form-label" for="fullName">Full Name</label>
        <input class="form-control" id="fullName" name="fullName" value="<%= values.fullName || '' %>" required autofocus>
      </div>
      <div class="mb-3">
        <label class="form-label" for="email">Email</label>
        <input class="form-control" id="email" name="email" type="email" value="<%= values.email || '' %>" required>
      </div>
      <div class="mb-3">
        <label class="form-label" for="mobileNumber">Mobile Number</label>
        <input class="form-control" id="mobileNumber" name="mobileNumber" value="<%= values.mobileNumber || values.phone || '' %>" placeholder="+260..." required>
      </div>
      <div class="mb-4">
        <label class="form-label" for="password">Password</label>
        <input class="form-control" id="password" name="password" type="password" minlength="8" required>
      </div>
      <button class="btn btn-gradient w-100" type="submit">Create Account</button>
      <p class="text-center mt-4 mb-0">Already registered? <a href="/login">Login</a></p>
    </form>
  </div>
</main>
<%- include('../partials/footer') %>
