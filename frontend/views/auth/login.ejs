<%- include('../partials/header') %>
<main class="container py-5">
  <div class="auth-card">
    <div class="text-center mb-4">
      <h1 class="h2">Sign in</h1>
      <p class="text-muted">Welcome back to your workspace</p>
    </div>
    
    <% if (error) { %>
      <div class="alert alert-danger border-0 rounded-3 mb-4" style="background: rgba(255, 61, 104, 0.12); color: #9f1239;" role="alert">
        <%= error %>
      </div>
    <% } %>
    
    <% if (message) { %>
      <div class="alert alert-success border-0 rounded-3 mb-4" role="alert">
        <%= message %>
      </div>
    <% } %>

    <form action="/login" method="post" class="stack-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      
      <div class="mb-3">
        <label for="identifier" class="form-label">Email or Mobile Number</label>
        <input type="text" id="identifier" name="identifier" class="form-control" value="<%= values.identifier || '' %>" required autofocus>
      </div>
      
      <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-1">
          <label for="password" class="form-label mb-0">Password</label>
          <a href="/forgot-password" style="font-size: 0.85rem; font-weight: 600;">Forgot password?</a>
        </div>
        <input type="password" id="password" name="password" class="form-control" required>
      </div>
      
      <button type="submit" class="btn btn-primary w-100 py-3 text-uppercase fw-bold" style="letter-spacing: 0.05em;">Sign In</button>
      
      <div class="text-center mt-4 pt-3 border-top">
        <span class="text-muted">Don't have an account?</span>
        <a href="/register" class="fw-bold ms-1">Create an account</a>
      </div>
    </form>
  </div>
</main>
<%- include('../partials/footer') %>
