<%- include('partials/header') %>
<main>
  <section class="landing-hero">
    <div class="container">
      <div class="hero-content">
        <div>
          <span class="section-kicker">Business Plan Co-pilot Assistant</span>
          <h1>MasterPlan</h1>
          <p class="hero-copy">Refine your business idea with a guided multi-step form that produces a clear, error-free, professional business plan powered by Artificial Intelligence, with the option of taking things even deeper by including real-world data in your market niche.</p>
          <div class="d-flex flex-wrap justify-content-center gap-3 mt-4">
            <a class="btn btn-gradient btn-lg" href="/register">Get your professional Business Plan today</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container metrics-section">
    <div class="section-heading metrics-heading">
      <span class="section-kicker">Live platform stats</span>
      <h2>What creators are building</h2>
    </div>
    <div class="metrics-bars" data-metrics-grid>
      <article class="metric-bar metric-blue">
        <span class="metric-bar-icon"><i class="fa-solid fa-chart-column"></i></span>
        <span class="metric-bar-label">Business Plans Created</span>
        <strong class="metric-number" data-metric="totalPlans">0</strong>
      </article>
      <article class="metric-bar metric-green">
        <span class="metric-bar-icon"><i class="fa-solid fa-users"></i></span>
        <span class="metric-bar-label">Active Users</span>
        <strong class="metric-number" data-metric="activeUsers">0</strong>
      </article>
      <article class="metric-bar metric-purple">
        <span class="metric-bar-icon"><i class="fa-solid fa-star"></i></span>
        <span class="metric-bar-label">Enhanced Plans</span>
        <strong class="metric-number" data-metric="enhancedPlans">0</strong>
      </article>
      <article class="metric-bar metric-orange">
        <span class="metric-bar-icon"><i class="fa-solid fa-lightbulb"></i></span>
        <span class="metric-bar-label">AI Insights</span>
        <strong class="metric-number" data-metric="totalInsights">0</strong>
      </article>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
